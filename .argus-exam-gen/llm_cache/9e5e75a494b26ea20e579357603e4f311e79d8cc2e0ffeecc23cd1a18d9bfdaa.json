{"name": "T1 PLAN AND LAUNCH", "goal": "Create a new mission, configure drone and flight parameters, and launch it successfully", "tags": ["critical", "smoke"], "requires_login": true, "start_url": "/missions", "steps": [{"el": "S2.e7", "action": "click", "value": "", "intent": "Open new mission wizard", "save_as": null}, {"el": "S7.e8", "action": "fill", "value": "${unique}", "intent": "Enter unique mission name", "save_as": "mission_name"}, {"el": "S7.e9", "action": "select", "value": "Survey", "intent": "Select mission type Survey", "save_as": null}, {"el": "S7.e10", "action": "select", "value": "Pune Depot", "intent": "Select base depot", "save_as": null}, {"el": "S7.e11", "action": "click", "value": "", "intent": "Proceed to drone selection", "save_as": null}, {"el": "S9.e8", "action": "click", "value": "", "intent": "Select a drone", "save_as": null}, {"el": "S9.e15", "action": "click", "value": "", "intent": "Proceed to flight parameters", "save_as": null}, {"el": "S10.e8", "action": "fill", "value": "100", "intent": "Set altitude 100 m", "save_as": null}, {"el": "S10.e9", "action": "fill", "value": "10", "intent": "Set speed 10 m/s", "save_as": null}, {"el": "S10.e12", "action": "click", "value": "", "intent": "Proceed to confirmation", "save_as": null}, {"el": "S11.e9", "action": "click", "value": "", "intent": "Confirm and schedule mission", "save_as": null}, {"el": "S12.e2", "action": "click", "value": "", "intent": "Launch mission", "save_as": null}], "oracles": [{"kind": "url_matches", "params": {"pattern": "missions/[a-z0-9]+"}, "description": "Mission detail page shows mission ID in URL", "rule_ref": "R4"}, {"kind": "network_called", "params": {"method": "POST", "path": "/api/missions", "status_class": "2xx"}, "description": "Mission created via API", "rule_ref": "R4"}, {"kind": "text_visible", "params": {"text": "${vars.mission_name}"}, "description": "Mission name appears on detail page", "rule_ref": "R4"}, {"kind": "text_visible", "params": {"text"