  {
    "id": "cancel-appointment",
    "name": "Cancel an appointment with explicit confirmation",
    "tags": [
      "critical",
      "cancel"
    ],
    "requires_login": false,
    "goal": "Cancel an appointment; verify confirmation dialog appears before removal and row is removed after confirming (B6)",
    "start_url": "/#/login",
    "steps": [
      {
        "intent": "Enter the front-desk email to sign in",
        "action": "fill",
        "find": {
          "role": "textbox",
          "name": "email"
        },
        "value": "${creds.user}"
      },
      {
        "intent": "Enter the password",
        "action": "fill",
        "find": {
          "type": "password"
        },
        "value": "${creds.password}"
      },
      {
        "intent": "Click the sign-in button",
        "action": "click",
        "find": {
          "role": "button",
          "name": "sign in"
        }
      },
      {
        "intent": "Wait for the overview to load",
        "action": "wait",
        "value": "1500"
      },
      {
        "intent": "Navigate to the appointments page",
        "action": "click",
        "find": {
          "role": "link",
          "name": "appointments"
        }
      },
      {
        "intent": "Wait for the appointment list to render",
        "action": "wait",
        "value": "500"
      },
      {
        "intent": "Click Cancel on the first appointment in the list",
        "action": "click",
        "find": {
          "role": "button",
          "name": "cancel"
        }
      },
      {
        "intent": "Wait for the confirmation dialog to appear",
        "action": "wait",
        "value": "500"
      },
      {
        "intent": "Confirm the cancellation in the dialog",
        "action": "click",
        "find": {
          "role": "button",
          "name": "yes, cancel"
        }
      },
      {
        "intent": "Wait for the row to be removed",
        "action": "wait",
        "value": "1000"
      }
    ],
    "oracles": [
      {
        "kind": "network_called",
        "params": {
          "method": "DELETE",
          "path": "/api/appointments/:id",
          "status_class": "2xx"
        },
        "description": "Cancellation API call succeeded",
        "rule_ref": "B6"
      },
      {
        "kind": "text_absent",
        "params": {
          "text": "Cancel this appointment?"
        },
        "description": "The confirmation dialog is closed once the cancellation is applied",
        "rule_ref": "B6"
      }
    ]
  },
