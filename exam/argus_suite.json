[
  {
    "id": "login",
    "name": "Front desk signs in",
    "tags": [
      "auth",
      "smoke"
    ],
    "requires_login": false,
    "goal": "A front-desk user with valid credentials reaches the clinic overview without a full-page reload",
    "start_url": "/#/login",
    "steps": [
      {
        "intent": "Enter the demo front-desk email",
        "action": "fill",
        "find": {
          "role": "textbox",
          "name": "email"
        },
        "value": "${creds.user}"
      },
      {
        "intent": "Enter the password",
        "action": "fill",
        "find": {
          "type": "password"
        },
        "value": "${creds.password}"
      },
      {
        "intent": "Submit the sign-in form",
        "action": "click",
        "find": {
          "role": "button",
          "name": "sign in"
        }
      },
      {
        "intent": "Wait for the clinic overview to load",
        "action": "wait",
        "value": "1500"
      }
    ],
    "oracles": [
      {
        "kind": "network_called",
        "params": {
          "method": "POST",
          "path": "/api/login",
          "status_class": "2xx"
        },
        "description": "A session is created by the API rather than a full page reload"
      },
      {
        "kind": "url_matches",
        "params": {
          "pattern": "app/home"
        },
        "description": "Clinic overview page is shown after login"
      },
      {
        "kind": "text_visible",
        "params": {
          "text": "Clinic pulse"
        },
        "description": "Clinic pulse overview heading is visible"
      }
    ]
  },
  {
    "id": "book-consultation",
    "name": "Book a consultation for a new patient",
    "tags": [
      "critical",
      "booking"
    ],
    "requires_login": false,
    "goal": "A front-desk user books a consultation for the first listed doctor, confirms it, and the API records the new appointment (the app exposes the same wizard from the 'New appointment' desk, which is used here because the doctor directory renders only after a client-side delay that the baseline recorder cannot observe)",
    "start_url": "/#/login",
    "steps": [
      {
        "intent": "Enter the front-desk email to sign in",
        "action": "fill",
        "find": {
          "role": "textbox",
          "name": "email"
        },
        "value": "${creds.user}"
      },
      {
        "intent": "Enter the password",
        "action": "fill",
        "find": {
          "type": "password"
        },
        "value": "${creds.password}"
      },
      {
        "intent": "Click the sign-in button",
        "action": "click",
        "find": {
          "role": "button",
          "name": "sign in"
        }
      },
      {
        "intent": "Wait for the overview to load",
        "action": "wait",
        "value": "1500"
      },
      {
        "intent": "Open the appointment desk from clinic navigation",
        "action": "click",
        "find": {
          "role": "link",
          "name": "new appointment"
        }
      },
      {
        "intent": "Wait for the booking wizard to load the doctor and open slots",
        "action": "wait",
        "value": "800"
      },
      {
        "intent": "Enter the patient name",
        "action": "fill",
        "find": {
          "role": "textbox",
          "name": "patient name"
        },
        "value": "Exam Patient",
        "save_as": "patient_name"
      },
      {
        "intent": "Enter the patient age 35",
        "action": "fill",
        "find": {
          "role": "textbox",
          "name": "age"
        },
        "value": "35"
      },
      {
        "intent": "Enter a valid phone number",
        "action": "fill",
        "find": {
          "role": "textbox",
          "name": "phone"
        },
        "value": "+91 9876543210"
      },
      {
        "intent": "Open the visit type selector",
        "action": "click",
        "find": {
          "role": "button",
          "name": "choose visit type"
        }
      },
      {
        "intent": "Select Consultation as the visit type",
        "action": "click",
        "find": {
          "role": "option",
          "name": "consultation"
        }
      },
      {
        "intent": "Continue to slot selection",
        "action": "click",
        "find": {
          "role": "button",
          "name": "next"
        }
      },
      {
        "intent": "Wait for the slot list to appear",
        "action": "wait",
        "value": "500"
      },
      {
        "intent": "Select the first available future appointment slot",
        "action": "click",
        "find": {
          "role": "radio",
          "context": "choose a time"
        }
      },
      {
        "intent": "Continue to the confirm step",
        "action": "click",
        "find": {
          "role": "button",
          "name": "next"
        }
      },
      {
        "intent": "Wait for the confirm page to appear",
        "action": "wait",
        "value": "500"
      },
      {
        "intent": "Confirm the booking",
        "action": "click",
        "find": {
          "role": "button",
          "name": "confirm booking"
        }
      },
      {
        "intent": "Wait for navigation to appointments list",
        "action": "wait",
        "value": "1500"
      }
    ],
    "oracles": [
      {
        "kind": "network_called",
        "params": {
          "method": "POST",
          "path": "/api/appointments",
          "status_class": "2xx"
        },
        "description": "Appointment is created via the API",
        "rule_ref": "B4"
      },
      {
        "kind": "url_matches",
        "params": {
          "pattern": "app/appointments"
        },
        "description": "Redirected to the appointments list after confirmation"
      },
      {
        "kind": "text_visible",
        "params": {
          "text": "Appointment confirmed"
        },
        "description": "The booking wizard confirms the new appointment was saved"
      }
    ]
  },
  {
