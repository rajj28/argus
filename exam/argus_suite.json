    "steps": [
      {
        "intent": "Enter the front-desk email to sign in",
        "action": "fill",
        "find": {
          "role": "textbox",
          "name": "email"
        },
        "value": "${creds.user}"
      },
      {
        "intent": "Enter the password",
        "action": "fill",
        "find": {
          "type": "password"
        },
        "value": "${creds.password}"
      },
      {
        "intent": "Click the sign-in button",
        "action": "click",
        "find": {
          "role": "button",
          "name": "sign in"
        }
      },
      {
        "intent": "Wait for the overview to load",
        "action": "wait",
        "value": "1500"
      },
      {
        "intent": "Open the appointment desk from clinic navigation",
        "action": "click",
        "find": {
          "role": "link",
          "name": "new appointment"
        }
      },
      {
        "intent": "Wait for the booking wizard to load the doctor and open slots",
        "action": "wait",
        "value": "800"
      },
      {
        "intent": "Enter a patient name",
        "action": "fill",
        "find": {
          "role": "textbox",
          "name": "patient name"
        },
        "value": "Age Test Patient"
      },
      {
        "intent": "Enter the invalid age 150",
        "action": "fill",
        "find": {
          "role": "textbox",
          "name": "age"
        },
        "value": "150"
      },
      {
        "intent": "Enter a valid phone number",
        "action": "fill",
        "find": {
          "role": "textbox",
          "name": "phone"
        },
        "value": "+91 9876543210"
      },
      {
        "intent": "Open the visit type selector",
        "action": "click",
        "find": {
          "role": "button",
          "name": "choose visit type"
        }
      },
      {
        "intent": "Select Consultation as the visit type",
        "action": "click",
        "find": {
          "role": "option",
          "name": "consultation"
        }
      },
      {
        "intent": "Click Next to attempt advancing past the patient details step",
        "action": "click",
        "find": {
          "role": "button",
          "name": "next"
        }
      },
      {
        "intent": "Wait for the age validation response",
        "action": "wait",
        "value": "500"
      }
    ],
    "oracles": [
      {
        "kind": "network_absent",
        "params": {
          "method": "POST",
          "path": "/api/appointments",
          "status_class": "2xx"
        },
        "description": "No appointment is created when age 150 is entered",
        "rule_ref": "B1"
      },
      {
        "kind": "text_visible",
        "params": {
          "text": "Age must be between"
        },
        "description": "Age validation error message is shown",
        "rule_ref": "B1"
      }
    ]
  },
